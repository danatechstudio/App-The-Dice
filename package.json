{
  "name": "rtd-companion-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Roll The Dice Companion App: PWA, API and sync on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "npm run build:web && vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "brand:assets": "python3 scripts/brand-assets.py",
    "db:migrate:local": "wrangler d1 migrations apply rtd-app --local",
    "db:migrate:remote": "wrangler d1 migrations apply rtd-app --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/arvo": "^5.3.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-preact": "^1.52.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "~4.1",
    "wrangler": "^4.147.0"
  }
}
